# ============================================================================
# Fiscal Friend 43 — exemplo de variáveis de ambiente
# ============================================================================
# COPIE este arquivo para `.env.local` e preencha com valores reais.
# NUNCA versione `.env.local`: ele contém segredos.
#
# Estado atual: o projeto roda no Lovable Cloud (backend Supabase/Postgres).
# A camada de sessão existe e é testada; a conexão com o banco ainda não foi
# validada contra uma instância real — enquanto SUPABASE_DB_URL/DATABASE_URL
# estiverem vazios, a sessão usa repositório em memória do processo.
#
# REGRA DE OURO: variável com prefixo VITE_ é EMBUTIDA NO NAVEGADOR. Nenhum
# segredo pode carregar esse prefixo.
# ============================================================================

# --- Aplicação -------------------------------------------------------------
# URL pública da API. Vazio = modo simulação (nenhuma chamada externa).
VITE_API_URL=

# --- Back-end / banco (fase 2) --------------------------------------------
# Lovable Cloud injeta SUPABASE_DB_URL no servidor. DATABASE_URL é a alternativa
# genérica (banco próprio, CI, deploy fora do Lovable).
#
# NUNCA prefixe com VITE_: o Vite embutiria o valor no bundle do navegador.
#
# Use a string do POOLER (porta 6543, modo transação) quando o servidor for
# efêmero/serverless; a conexão direta (5432) serve para processo de vida longa.
SUPABASE_DB_URL=
DATABASE_URL=

# SSL da conexão: `require` (padrão, verifica o certificado), `no-verify`
# (certificado interno/autoassinado) ou `disable` (nunca em produção).
DATABASE_SSL=require

# Pool e tempo limite por instrução.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Front-end (Lovable Cloud) --------------------------------------------
# Estas SIM levam VITE_: são públicas por design e trafegam no navegador.
# A chave secreta (service_role / sb_secret) NUNCA entra aqui — ela tem
# BYPASSRLS e anularia por completo o isolamento por tenant do migration 001.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Persistência da autenticação (etapa 2.6) ---------------------------
# auto     = (padrão) usa Postgres se SUPABASE_DB_URL/DATABASE_URL existir;
#            memória caso contrário.
# postgres = exige Postgres. Sem string de conexão, a inicialização FALHA com
#            mensagem explícita — o sistema não finge que tem banco.
# memoria  = repositório em memória do processo. APENAS desenvolvimento/teste:
#            recusado em produção, porque as sessões sumiriam no restart.
FISCAL_PERSISTENCIA=auto

# --- Usuário de desenvolvimento (etapa 2.6) -----------------------------
# Cria UM usuário no repositório em memória, na inicialização da sessão.
# Sem estas duas variáveis, nenhum usuário é criado — não existe senha padrão
# embutida no código. Use uma senha longa e descartável.
DEV_AUTH_EMAIL=
DEV_AUTH_SENHA=
DEV_AUTH_TENANT=tenant-dev
DEV_AUTH_USUARIO=usr-dev-1
# administrador | fiscal | operador | suporte | auditor
DEV_AUTH_PAPEL=administrador

# --- Estrutura de desenvolvimento (etapa 2.8) ----------------------------
# Usado apenas quando DEV_AUTH_EMAIL está definido E há banco Postgres.
# Cria as linhas de tenant, empresa e estabelecimento exigidas pelas chaves
# estrangeiras de documentos_fiscais. Em produção NADA é criado aqui: o
# cadastro de empresa/estabelecimento ainda não foi implementado, e a tela de
# documentos recusa a operação com mensagem explícita em vez de inventar um
# estabelecimento.
#
# Os identificadores são UUIDs determinísticos derivados de DEV_AUTH_TENANT
# (ver uuidDeterministico em src/fiscal/servidor/ambiente.ts): o segundo
# arranque encontra as mesmas linhas em vez de criar um segundo tenant. O
# tenant mostrado na tela de login é esse UUID derivado — a string literal
# "tenant-dev" não é UUID e quebraria o caminho Postgres.
DEV_EMPRESA_NOME=Empresa de Desenvolvimento
# 14 dígitos, sem pontuação. O CHECK do schema exige o formato.
DEV_EMPRESA_CNPJ=11222333000181

# --- Certificado digital (fase 5) -----------------------------------------
# Caminho para o arquivo PKCS#12 (.pfx) e a respectiva senha.
# O certificado e a senha NUNCA trafegam pelo front-end: ficam apenas no
# back-end, em repositório de segredos.
CERTIFICADO_PFX_PATH=
CERTIFICADO_PFX_SENHA=

# --- Provedores (fase 5) ---------------------------------------------------
# Tokens de integração. Vazio = gateways simulados em uso.
TECNOSPEED_TOKEN=
PLUGNOTAS_API_KEY=

# --- Ambiente fiscal -------------------------------------------------------
# 1 = produção, 2 = homologação. O protótipo é fixo em 2 (homologação) e
# está impedido de gerar tpAmb=1 — ver src/simulation/documento-saida.ts.
NFE_AMBIENTE=2
NFCE_AMBIENTE=2
CTE_AMBIENTE=2
MDFE_AMBIENTE=2

# --- Observabilidade (fase 7) ---------------------------------------------
LOG_LEVEL=info
