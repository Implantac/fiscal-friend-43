# ============================================================================
# Fiscal Friend 43 — exemplo de variáveis de ambiente
# ============================================================================
# COPIE este arquivo para `.env.local` e preencha com valores reais.
# NUNCA versione `.env.local`: ele contém segredos.
#
# Estado atual: o protótipo NÃO possui back-end, banco de dados, autenticação
# nem integração externa. Todas as variáveis abaixo são o CONTRATO previsto
# para as fases 2 a 5 — nenhuma delas é lida hoje pelo front-end.
# Enquanto a integração real não existir, o sistema opera em Ambiente de
# Simulação e estas chaves permanecem vazias.
# ============================================================================

# --- Aplicação -------------------------------------------------------------
# URL pública da API. Vazio = modo simulação (nenhuma chamada externa).
VITE_API_URL=

# --- Back-end / banco (fase 2) --------------------------------------------
# String de conexão do banco relacional. Só existe no servidor, nunca no
# front-end. Use o gerenciador de segredos do ambiente de hospedagem.
DATABASE_URL=

# --- Certificado digital (fase 5) -----------------------------------------
# Caminho para o arquivo PKCS#12 (.pfx) e a respectiva senha.
# O certificado e a senha NUNCA trafegam pelo front-end: ficam apenas no
# back-end, em repositório de segredos.
CERTIFICADO_PFX_PATH=
CERTIFICADO_PFX_SENHA=

# --- Provedores (fase 5) ---------------------------------------------------
# Tokens de integração. Vazio = gateways simulados em uso.
TECNOSPEED_TOKEN=
PLUGNOTAS_API_KEY=

# --- Ambiente fiscal -------------------------------------------------------
# 1 = produção, 2 = homologação. O protótipo é fixo em 2 (homologação) e
# está impedido de gerar tpAmb=1 — ver src/simulation/documento-saida.ts.
NFE_AMBIENTE=2
NFCE_AMBIENTE=2
CTE_AMBIENTE=2
MDFE_AMBIENTE=2

# --- Observabilidade (fase 7) ---------------------------------------------
LOG_LEVEL=info
